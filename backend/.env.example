# AI (AgriChatBot + Crop Doctor) - FREE by default.
# Leave everything empty to use Ollama on this computer (install from ollama.com, then: ollama pull gemma3:4b)
# AI_PROVIDER=ollama          # ollama | groq | anthropic | offline (empty = pick automatically)
# OLLAMA_MODEL=gemma3:4b
# GROQ_API_KEY=                # free key from console.groq.com (optional online backup)
# GROQ_MODEL=openai/gpt-oss-120b          # optional: Groq retires models; see console.groq.com/docs/models
# GROQ_VISION_MODEL=qwen/qwen3.8-27b      # optional: photo model for Crop Doctor
# ANTHROPIC_API_KEY=           # Claude (paid, optional)

# Push notifications (Firebase) - path to the service account key file
FIREBASE_SERVICE_ACCOUNT=
